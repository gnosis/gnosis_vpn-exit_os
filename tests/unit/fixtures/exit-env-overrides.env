# exit.env overrides for the ported blocklist and shaping suites: the values the
# scripts under test read, so their assertions are about the code, not the
# image defaults.
WIREGUARD_CIDR=10.128.0.0/24
GVPN_PEER_MIN_OCTET=2
GVPN_PEER_MAX_OCTET=254
GVPN_PEER_RATE_KBIT=7500
GVPN_PEER_SHAPING_AGGREGATE_KBIT=30000
GVPN_BLOCKLIST_IPSET_NAME=gvpn-blocklist
GVPN_BLOCKLIST_MAXELEM=131072
GVPN_BLOCKLIST_MIN_ENTRIES=1000
