# Pinned inputs of the recovery stick (docs/recovery.md). Bumped by PR only.

# Upper bound on the Unified Kernel Image, enforced by image/recovery/build.sh.
# Measured on Fedora 44: kernel 18 MB plus a 42 MB dracut initrd, because
# Fedora's udev drags the systemd module in; the budget catches a stray
# firmware blob or a module regression before it reaches a stick, and shrinks
# if the initrd is ever replaced by a busybox one (docs/recovery.md).
RECOVERY_MAX_BYTES=75497472
