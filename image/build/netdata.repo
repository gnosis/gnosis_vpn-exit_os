# Fedora release-specific: the Containerfile substitutes the base image's major
# version for the placeholder in baseurl, so a Fedora rebase needs no edit here.
[netdata]
name=Netdata stable
baseurl=https://repository.netdata.cloud/repos/stable/fedora/@FEDORA_MAJOR@/x86_64/
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-netdata
