# Pinned inputs of the OS image. Bumped by PR only; every value is consumed by
# the Containerfile as a build arg (see `just build`).

# Base image (Fedora IoT, image mode). Quay garbage-collects the manifests of
# older Fedora rebuilds, so this digest stops resolving once the tag has moved
# on; bump it to the current one when a build fails with "manifest unknown":
#   just update-pins
FEDORA_IOT_IMAGE=quay.io/fedora/fedora-iot:44@sha256:a30461f19731be13a48e7515e1dc5219c3bc9a8f9b26b703914362f9a4435efc

# hoprd v5 line. The PIX-enabled binary is published as an OCI image
# (europe-west3-docker.pkg.dev/hoprassociation/docker-images/hoprd); the GitHub
# release binary is built without `strategy-pix-curvy` and cannot run the Pix
# strategy. The image also carries the Curvy proving artifacts. Both the image
# digest and the copied binaries are pinned.
HOPRD_VERSION=5.0.3-pr.261
HOPRD_IMAGE=europe-west3-docker.pkg.dev/hoprassociation/docker-images/hoprd:5.0.3-pr.261@sha256:561e9e176c74ac5fcac0714e284975f61d0faab533a405f9512af5e66e581f69
HOPRD_SHA256=d8e3d004d9d965724c88c6cb25821dc7d75c4ca2106b58dec97912f8dfa544f7
HOPRD_CFG_SHA256=39886188dba5116cbdf32bfdf2884c9b06f9690cac81e19005e45d41658f3367

# hoprd v4 line, kept only for the v4 channel and Safe cleanup helper that an
# upgraded device runs once. Signed by keys/hoprnet-release.asc.
HOPRD_V4_VERSION=4.1.3
HOPRD_V4_SHA256=28e00b385a4630ccbdab88cbcf59ed266d47141f38f97891732925312e40339d
HOPRD_V4_CFG_SHA256=29def85fa0e6dc9395369d77dadcb18d1fa8f2c19638b9d02b2d6f2de7c3b96f

# hopli (github.com/hoprnet/hopli), the v5 line that pairs with hoprd 5.0.2,
# used for `hopli identity create`, `hopli safe-module` and service registry
# work, signed by keys/hoprnet-release.asc.
HOPLI_VERSION=0.20.1
HOPLI_SHA256=7f7192eeece9c39c4212696729d52194a650688f9817621128d8e28d377360d8

# Foundry's cast, used by the v4-to-v5 helper to sign one Safe transaction
# from the old Safe (hoprd's own /account/withdraw sends from the node, not the
# Safe). The release tarball is verified by the sha256 published beside it.
FOUNDRY_VERSION=1.9.0
FOUNDRY_SHA256=8d17599b42e3139f1a9c171be3798c4ed8e743ae17b84cc3435e57bf2a51ae99

# gnosis_vpn-server (github.com/gnosis/gnosis_vpn-server), signed by keys/gnosisvpn-release.asc
GVPN_SERVER_VERSION=0.7.0
GVPN_SERVER_SHA256=50caa9d4fcf3340cf86d603c5fa001b80b612d117016fd1e9cd5e7d58398ca87

# netdata from netdata's official Fedora repo (Fedora's package is orphaned),
# signed by keys/netdata-repo.asc
NETDATA_VERSION=2.11.1
