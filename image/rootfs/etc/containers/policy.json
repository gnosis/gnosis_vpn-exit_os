{
    "default": [
        {
            "type": "reject"
        }
    ],
    "transports": {
        "docker": {
            "registry.example.org/gvpn-exit-os": [
                {
                    "type": "sigstoreSigned",
                    "keyPath": "/etc/pki/containers/gvpn-exit-os.pub",
                    "signedIdentity": {
                        "type": "matchRepository"
                    }
                }
            ]
        },
        "containers-storage": {
            "": [{"type": "insecureAcceptAnything"}]
        },
        "oci": {
            "": [{"type": "insecureAcceptAnything"}]
        },
        "oci-archive": {
            "": [{"type": "insecureAcceptAnything"}]
        },
        "dir": {
            "": [{"type": "insecureAcceptAnything"}]
        }
    }
}
