# Image defaults for the GnosisVPN exit appliance. This file is sourced over
# the process environment, so every knob it names is set here: a value exported
# before a script runs is replaced, and a device changes a knob only through
# /etc/gvpn-exit/exit.env, which is read after this file and may build on its
# values. load_exit_env evaluates that file in a subshell and takes over what it
# sets, so one that does not run cleanly costs the overrides and not the boot;
# a value that parses but that its consumer rejects (GVPN_PEER_MIN_SHARE_KBIT=0,
# for example) still stops the unit that reads it and turns the boot red. Some
# of these knobs are shared with parts of the image that cannot read them: see
# the notes on the network interface, the session target and the self-address
# set below.

# LAN uplink; the .link file renames the wired NIC to this name. The static
# ruleset, the sshd dispatcher and the netprobe/capacity probes also name lan0,
# so a different name is an image change, not a device override.
NETWORK_INTERFACE=lan0

# WireGuard server managed by gnosis_vpn-server. The pool must stay a /24: the
# peer pool and the shaping table vary the last octet only. The session ping
# allowance, NAT and the pool all derive from these two values.
WIREGUARD_CIDR=10.128.0.0/24
WIREGUARD_ADDRESS=10.128.0.1/32
WIREGUARD_PORT=51820
WIREGUARD_MTU=1420
# Session target the GnosisVPN client dials by default: 172.30.0.1 is the
# session target address built into the client. It is kept on lo
# (gvpn-exit-loopback-alias.service) so hoprd reaches the local services
# without a LAN route. The address is shared with hoprd's target_allow_list in
# /usr/share/gvpn-exit/hoprd.cfg.yaml and with the exit block of the
# provisioning record, so changing it means editing those as well.
GVPN_SESSION_TARGET_ADDRESS=172.30.0.1/32
GVPN_SERVER_ENDPOINT=172.30.0.1:8000
GVPN_CLIENT_HANDSHAKE_TIMEOUT_S=300
GVPN_CLIENT_CLEANUP_INTERVAL_S=180

# Peer pool: last-octet bounds within WIREGUARD_CIDR's /24. Also sizes the
# per-peer shaping classes, so the pool is the concurrent client limit. `auto`
# derives the end of the pool from the measured uplink (capacity.sh): one slot
# per GVPN_PEER_MIN_SHARE_KBIT of the aggregate. A number pins it.
GVPN_PEER_MIN_OCTET=2
GVPN_PEER_MAX_OCTET=auto

# Per-peer shaping (HTB + fq_codel), kbit/s per direction, and the node-wide
# aggregate cap for peer traffic. `auto` derives the aggregate from the
# measured uplink; a number pins it. The effective per-peer ceiling and
# guarantee follow from the aggregate and the pool size (lib.sh).
GVPN_PEER_RATE_KBIT=10000
GVPN_PEER_SHAPING_AGGREGATE_KBIT=auto

# Uplink measurement and capacity policy (capacity.sh, lib.sh). The exit shares
# the public link with hoprd, netdata, image updates and the operator: VPN
# traffic gets one GVPN_UPLINK_SHARE_DIVISOR of the measured link, and every
# concurrent client is admitted against GVPN_PEER_MIN_SHARE_KBIT of that share.
# A 200 Mbit/s link therefore carries 50 Mbit/s of VPN traffic: ten clients,
# each with a 10 Mbit/s ceiling and a 5 Mbit/s guaranteed share.
GVPN_UPLINK_SHARE_DIVISOR=4
GVPN_PEER_MIN_SHARE_KBIT=5000
# Without a usable measurement the device assumes the supported-environment
# floor (30 Mbit/s, one client) instead of the fastest link it ever saw.
GVPN_PEER_CAPACITY_FALLBACK_KBIT=7500
# The slowest sample the device shapes to, per direction. A probe that completes
# below it ran on a link throttled to a trickle and counts as a failed probe:
# the last good sample stays, or the floor above when there is none.
GVPN_CAPACITY_MIN_KBIT=1000
# The probe: Cloudflare's speed test endpoints (`__down`, `__up`) under
# GVPN_CAPACITY_URL, GVPN_CAPACITY_STREAMS parallel streams per direction, the
# first GVPN_CAPACITY_WARMUP_S seconds discarded and the next
# GVPN_CAPACITY_WINDOW_S seconds counted on the LAN port. Counts and durations
# run from 1 to 99; the whole probe has to fit the unit's 120 s start timeout.
GVPN_CAPACITY_URL=https://speed.cloudflare.com
GVPN_CAPACITY_STREAMS=4
GVPN_CAPACITY_WARMUP_S=3
GVPN_CAPACITY_WINDOW_S=8

# Netprobe (gvpn-exit-netprobe.timer) and the wanted network check: the HTTPS
# services that report this device's public IPv4 address, in the order they are
# asked (the first valid answer wins), the bound on one UPnP/NAT-PMP router
# query, how long a run waits for the probe lock before it skips this tick, and
# the host that proves DNS works.
GVPN_PUBLIC_IP_URLS="https://checkip.amazonaws.com https://api.ipify.org https://www.cloudflare.com/cdn-cgi/trace"
GVPN_ROUTER_PROBE_TIMEOUT_S=10
GVPN_NETPROBE_LOCK_WAIT_S=300
GVPN_DNS_PROBE_HOST=hub.hoprnet.org

# IP blocklist
GVPN_BLOCKLIST_IPSET_NAME=gvpn-blocklist
GVPN_BLOCKLIST_MAXELEM=131072
GVPN_BLOCKLIST_CACHE_DIR=/var/lib/gvpn-blocklist
GVPN_BLOCKLIST_TEXTFILE_DIR=/var/lib/node_exporter/textfile
GVPN_BLOCKLIST_MIN_ENTRIES=1000
GVPN_BLOCKLIST_CURL_TIMEOUT=30
GVPN_BLOCKLIST_MAX_FILESIZE=67108864
# Share of the IPv4 space the list may drop, in percent. A poisoned feed can
# pass the entry-count checks with a few thousand /8s, so this bounds it. It is
# a sanity ceiling, not a policy: the default FireHOL level1 snapshot covers
# about 14% of IPv4 because it aggregates whole networks.
GVPN_BLOCKLIST_MAX_COVERAGE_PCT=25
# Space-separated feed URLs, each an https:// URL: curl is restricted to https
# for the request and for every redirect. The default is FireHOL's level1
# aggregate on its upstream master branch: the content moves with upstream and
# nothing authenticates it, so trust in the list is trust in that URL. That is
# accepted, and bounded rather than fixed: the parser takes IPv4 only and no
# prefix shorter than /8 outside 224/3, the entry count must stay inside the
# band below, and the coverage ceiling rejects a list that would blackhole most
# of the internet. A deployment that needs a feed whose content is fixed mirrors
# it and points this at the mirror; pinning the upstream by commit would freeze
# the data, which is what the refresh timer exists to avoid.
GVPN_BLOCKLIST_FEEDS="https://raw.githubusercontent.com/firehol/blocklist-ipsets/master/firehol_level1.netset"

# This device's own public IPv4 addresses (announced, HTTPS-observed,
# router-reported), maintained by self-ipset.sh. GVPN_PRIVATE drops them so VPN
# clients cannot reach the router or a hairpinned LAN host through them. At
# most three members; maxelem has to hold them and stay a value ipset accepts,
# so it is taken only between 3 and 65536 and falls back to the default
# otherwise. The set is named gvpn-self by the static ruleset and by the
# greenboot firewall check, so its name is an image constant, not a device
# override: load_exit_env puts it back after the overrides in
# /etc/gvpn-exit/exit.env.
GVPN_SELF_IPSET_NAME=gvpn-self
GVPN_SELF_IPSET_MAXELEM=16
