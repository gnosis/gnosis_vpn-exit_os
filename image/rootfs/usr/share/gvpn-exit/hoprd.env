# Image defaults for hoprd.service. Device values (Safe, module, Blokli URL)
# come from /etc/hoprd-v5/hoprd.env.d/10-provisioned.env; secrets come from the sealed
# credentials (hoprd-run.sh). Public IPv4 and announcement are set by
# gvpn-exit-hoprd-address in /var/lib/gvpn-exit/state/hoprd-host.env.
#
# v5 keeps its database apart from the v4 one so the old identity and DB stay
# usable by the migration helper and by a rollback to the previous deployment.
HOPRD_DATA=/var/lib/hoprd-v5
HOPRD_API=1
HOPRD_API_HOST=127.0.0.1
HOPRD_API_PORT=3001
RUST_LOG=info,isahc=error,sea_orm=warn,sqlx=warn,hyper_util=warn,hickory_resolver=warn
RUST_BACKTRACE=1
# Curvy proving artifacts, copied from the PIX-enabled hoprd image at build
# time. The pool reads the flat directory below; without it the first deposit
# fails with "location is not configured".
CURVY_ZK_KEYS_DIR=/usr/share/gvpn-exit/curvy-zk
