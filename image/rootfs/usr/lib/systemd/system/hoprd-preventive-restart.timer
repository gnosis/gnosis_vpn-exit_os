[Unit]
Description=Restart hoprd daily inside the maintenance window
ConditionPathExists=/var/lib/gvpn-exit/identity/provisioned

[Timer]
# The 05:00-06:00 restart range follows update-apply's 03:00 plus up to 2h
# window; not Persistent, so it never catches up outside the window.
OnCalendar=*-*-* 05:00:00
RandomizedDelaySec=1h
Unit=hoprd-preventive-restart.service

[Install]
WantedBy=timers.target
